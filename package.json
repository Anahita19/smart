{
  "name": "smart-expense-tracker",
  "description": "A privacy-first personal finance dashboard that runs entirely in the browser and installs as an offline-capable PWA.",
  "private": true,
  "license": "MIT",
  "keywords": ["expense-tracker", "personal-finance", "react", "typescript", "vite", "tailwindcss", "pwa", "offline-first"],
  "version": "0.2.0",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "npm run test:ts && npm run test:pwa",
    "test:ts": "node --experimental-strip-types --import ./tests/register-alias.mjs --test \"tests/*.test.ts\"",
    "test:pwa": "node --experimental-strip-types --test tests/pwa.stage6.test.mjs tests/pwa.stage6.hardening.test.mjs"
  },
  "dependencies": {
    "lucide-react": "^0.544.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.9.2",
    "vite": "^7.1.0"
  }
}
